{
  "name": "ats-network-node",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Independent ATS audiobook storage, signed discovery, and optional NVIDIA VoxCPM2 speech node",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs && node --check src/mesh.mjs && node --check src/bind-wallet.mjs",
    "verify:node": "node scripts/verify-node.mjs",
    "verify:prepare": "node scripts/verify-node.mjs prepare",
    "verify:resume": "node scripts/verify-node.mjs resume"
  },
