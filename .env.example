# Public HTTPS origin used in generated download URLs. Loopback HTTP is development only.
NODE_PUBLIC_URL=http://127.0.0.1:8787
NODE_PORT=8787
NODE_MAX_FILE_BYTES=1073741824
NODE_OWNER_QUOTA_BYTES=10737418240
NODE_TOTAL_QUOTA_BYTES=107374182400
NODE_MAX_ENTRIES=50000
NODE_MAX_OWNER_ENTRIES=1000
NODE_UPLOAD_TTL_HOURS=168
# Comma-separated SHA256(raw Ed25519 public key) owner IDs permitted to moderate.
NODE_ADMIN_PUBLIC_KEYS=
# Public, monitored HTTPS contact page. Public/unlisted books stay unavailable without it.
NODE_MODERATION_CONTACT_URL=
# The voice-market Compose service uses its own contact and administrator subjects.
VOICE_MARKET_MODERATION_CONTACT_URL=
VOICE_MARKET_ADMIN_SUBJECTS=
# Voice Market test transactions are opt-in. Set 1 to enable sandbox credits.
VOICE_MARKET_SANDBOX_ENABLED=0
# For Base Sepolia test transactions, leave sandbox credits disabled and
# configure the deployed v2 settlement contract and its HTTPS testnet RPC.
# VOICE_MARKET_SETTLEMENT_CHAIN_ID=84532
# VOICE_MARKET_SETTLEMENT_ADDRESS=
# VOICE_MARKET_CHAIN_RPC=
# VOICE_MARKET_SETTLEMENT_HOLD_SECONDS=604800
# Set this to the HTTPS origin when placing the service behind a proxy.
# VOICE_MARKET_PUBLIC_URL=https://voice.example.org
# Optional settlement address; putting it here does not prove ownership or send transactions.
NODE_PROVIDER_ADDRESS=
# Optional public HTTPS overlay; DNS must point to the Docker host.
# NODE_DOMAIN=books.example.org
# Local-chain acceptance only: set from scripts/verify-node.mjs output before verify-chain.
# NODE_RESOURCE_ID=
# EXPECTED_NODE_ID=

# Production peers require HTTPS and a verified SHA256(raw Ed25519 key) pin.
NODE_PEERS=[]
NODE_DESIRED_REPLICAS=2
NODE_REPLICA_QUOTA_BYTES=10737418240
NODE_MESH_INTERVAL_SECONDS=60
NODE_DRAIN=0
# Comma-separated trusted settlement signer IDs. Leave empty to reject leases.
NODE_SETTLEMENT_PUBLIC_KEYS=

# GPU operator: scripts/start-gpu-node.sh generates secrets/tts_api_key and
# supplies its group ID automatically. Public deployment also requires NODE_DOMAIN.
# Shared gateway/engine concurrency, 1...128. Default 8; size GPU memory before
# increasing. Overrides YAML max_num_seqs and decode graph batch capacity.
TTS_PORT=8791
TTS_MAX_CONCURRENT=8
# Optional graph pool cap, 1...TTS_MAX_CONCURRENT; empty follows concurrency.
TTS_CUDA_GRAPH_MAX_BATCH_SIZE=
TTS_TIMEOUT_SECONDS=180
# Gateway RAM/CPU limits can be raised for many simultaneous reference WAVs.
TTS_GATEWAY_MEMORY_LIMIT=1g
TTS_GATEWAY_CPUS=2

# Optional translation gateway (compose.translation.yaml).
# API keys live in secrets/translation_api_key, never in this file.
TRANSLATION_UPSTREAM=http://translation-engine:8000
TRANSLATION_MODEL=translategemma-27b-it
TRANSLATION_PROMPT_FORMAT=translategemma
TRANSLATION_PORT=8792
TRANSLATION_MAX_CONCURRENT=2
TRANSLATION_TIMEOUT_SECONDS=120
# For HTTPS use https://YOUR_NODE_DOMAIN/translation.
TRANSLATION_PUBLIC_URL=http://127.0.0.1:8792
